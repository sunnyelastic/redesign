<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light" />
  <title>Elastic 2026 — Latest all 5 pages</title>
  <!-- Elastic 2026 web-font loader: share-safe, no embedded font binaries -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&family=Inter:wght@100..900&family=Space+Grotesk:wght@300..700&family=Space+Mono:wght@400;700&family=Noto+Sans+Symbols+2&display=swap" rel="stylesheet">
<style id="elastic-2026-font-normalizer">
  :root {
    --mono:'Geist Mono','Noto Sans Symbols 2',ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,'Liberation Mono',monospace;
    --body:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
    --spgrotesk:'Space Grotesk','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
    --spmono:'Space Mono','Noto Sans Symbols 2',ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,'Liberation Mono',monospace;
  }
  html { font-synthesis: none; text-rendering: optimizeLegibility; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
</style>
  <style>
    :root { --ink:#1C1E23; --ink-2:#343741; --muted:#69707D; --blue:#0B64DD; --line:#DCE2EA; --bg:#F5F7FA; }
    * { box-sizing:border-box; }
    html,body { margin:0; width:100%; height:100%; overflow:hidden; background:#fff; color:var(--ink); font-family:var(--body); }
    .shell { height:100dvh; display:grid; grid-template-rows:auto minmax(0,1fr); background:#fff; }
    .top { min-height:58px; display:flex; align-items:center; gap:16px; padding:10px 16px; border-bottom:1px solid var(--line); background:rgba(255,255,255,.98); position:relative; z-index:20; box-shadow:0 1px 0 rgba(28,30,35,.04); }
    .brand { font-family:var(--mono); font-size:12px; font-weight:750; letter-spacing:.12em; line-height:1.2; text-transform:uppercase; white-space:nowrap; color:var(--blue); }
    .tabs { display:flex; align-items:center; gap:6px; overflow:auto; scrollbar-width:thin; flex:1; padding:2px 0; }
    .tab { appearance:none; border:1px solid transparent; border-radius:0; background:transparent; color:var(--ink-2); cursor:pointer; font-family:var(--body); font-weight:650; font-size:13px; line-height:1.2; min-height:34px; padding:8px 10px; white-space:nowrap; }
    .tab:hover { border-color:var(--line); background:var(--bg); color:var(--ink); }
    .tab[aria-current="page"] { background:var(--ink); border-color:var(--ink); color:#fff; }
    .status { color:var(--muted); font-size:12px; line-height:1.3; white-space:nowrap; }
    .viewer { min-height:0; position:relative; background:#fff; }
    iframe { width:100%; height:100%; border:0; display:block; background:#fff; }
    .toast { position:absolute; right:16px; bottom:16px; max-width:min(460px, calc(100% - 32px)); border:1px solid var(--line); background:#fff; box-shadow:0 14px 40px rgba(28,30,35,.14); color:var(--ink-2); font-size:13px; line-height:1.45; padding:10px 12px; opacity:0; transform:translateY(8px); pointer-events:none; transition:opacity .18s ease, transform .18s ease; z-index:30; }
    .toast.show { opacity:1; transform:translateY(0); }
    .loading { position:absolute; inset:0; display:grid; place-items:center; background:#fff; color:var(--muted); font-size:13px; z-index:1; transition:opacity .15s ease; }
    .loading.hide { opacity:0; pointer-events:none; }
    @media (max-width:760px) { .top { flex-direction:column; align-items:flex-start; gap:8px; } .tabs { width:100%; } .status { display:none; } .tab { font-size:12px; min-height:32px; padding:7px 9px; } }
  </style>
</head>
<body>
  <div class="shell">
    <header class="top">
      <div class="brand">Elastic 2026 preview</div>
      <nav class="tabs" aria-label="Prototype pages">
        <button class="tab" type="button" data-page="home">Home</button>
        <button class="tab" type="button" data-page="observability">Observability</button>
        <button class="tab" type="button" data-page="security" aria-current="page">Security</button>
        <button class="tab" type="button" data-page="platform">Platform</button>
        <button class="tab" type="button" data-page="enterprise-search">Enterprise Search</button>
      </nav>
      <div class="status" id="status">Latest pages loaded.</div>
    </header>
    <main class="viewer">
      <div class="loading" id="loading">Loading page…</div>
      <iframe id="frame" title="Elastic 2026 prototype page" allow="fullscreen; clipboard-read; clipboard-write; web-share"></iframe>
      <div class="toast" id="toast" role="status" aria-live="polite"></div>
    </main>
  </div>

  <script id="page-data" type="application/json">{"home":{"label":"Home","gz_b64":""},"observability":{"label":"Observability","gz_b64":""},"security":{"label":"Security","gz_b64":""},"platform":{"label":"Platform","gz_b64":""},"enterprise-search":{"label":"Enterprise Search","gz_b64":""}}</script>
  <script>
    const DATA = JSON.parse(document.getElementById('page-data').textContent);
    const frame = document.getElementById('frame');
    const loading = document.getElementById('loading');
    const status = document.getElementById('status');
    const toast = document.getElementById('toast');
    const tabs = Array.from(document.querySelectorAll('.tab'));
    const decodedCache = new Map();
    let toastTimer = null;
    let loadToken = 0;
    const fontStatus = new Map();

    function showToast(message) {
      toast.textContent = message;
      toast.classList.add('show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.remove('show'), 2600);
    }
    function bytesFromBase64(b64) {
      const binary = atob(b64);
      const bytes = new Uint8Array(binary.length);
      for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
      return bytes;
    }
    async function decodeGzipBase64(b64) {
      if (!('DecompressionStream' in window)) throw new Error('This browser preview needs Chrome/Edge/Safari 17+ to decompress the single-file payload.');
      const bytes = bytesFromBase64(b64);
      const stream = new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'));
      return await new Response(stream).text();
    }
    async function getPageHtml(key) {
      if (decodedCache.has(key)) return decodedCache.get(key);
      const html = await decodeGzipBase64(DATA[key].gz_b64);
      decodedCache.set(key, html);
      return html;
    }
    function setTabs(key) {
      tabs.forEach(tab => tab.setAttribute('aria-current', tab.dataset.page === key ? 'page' : 'false'));
    }
    function prettyFonts(fonts) {
      if (!fonts) return 'Fonts loading…';
      const good = ['geist','inter','spaceGrotesk','spaceMono'].filter(k => fonts[k]).length;
      return good === 4 ? 'Fonts loaded: Geist Mono, Inter, Space Grotesk, Space Mono.' : 'Web-font loader active. Waiting on browser/network font fetch.';
    }
    async function setPage(key, pushHash = true) {
      if (!DATA[key]) key = 'home';
      const token = ++loadToken;
      setTabs(key);
      document.title = 'Elastic 2026 — ' + DATA[key].label;
      status.textContent = DATA[key].label + ' loaded. ' + prettyFonts(fontStatus.get(key));
      loading.textContent = 'Loading ' + DATA[key].label + '…';
      loading.classList.remove('hide');
      try {
        const html = await getPageHtml(key);
        if (token !== loadToken) return;
        frame.onload = () => loading.classList.add('hide');
        frame.srcdoc = html;
        if (pushHash) { try { history.replaceState(null, '', '#' + key); } catch (e) {} }
      } catch (err) {
        loading.textContent = 'Could not load preview: ' + err.message;
      }
    }
    tabs.forEach(tab => tab.addEventListener('click', () => setPage(tab.dataset.page)));
    window.addEventListener('message', event => {
      if (!event.data || typeof event.data !== 'object') return;
      if (event.data.type === 'elastic-preview-switch-page' && DATA[event.data.page]) setPage(event.data.page);
      if (event.data.type === 'elastic-preview-external-link') showToast('External links are disabled in this preview so ChatGPT does not show the link verification screen.');
      if (event.data.type === 'elastic-font-status' && DATA[event.data.page]) {
        fontStatus.set(event.data.page, event.data.fonts);
        const current = tabs.find(t => t.getAttribute('aria-current') === 'page')?.dataset.page;
        if (current === event.data.page) status.textContent = DATA[event.data.page].label + ' loaded. ' + prettyFonts(event.data.fonts);
      }
    });
    window.addEventListener('hashchange', () => setPage((location.hash || '#security').slice(1), false));
    if (document.fonts && document.fonts.ready) document.fonts.ready.catch(()=>{});
    setPage((location.hash || '#security').slice(1), false);
  </script>
</body>
</html>
